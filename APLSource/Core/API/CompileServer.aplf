 msg←CompileServer args;schemaFile;serverdir;toolsdir;toolsrestdir;nsname;svcdir;schema;lines;handlerdir;opts;r
⍝ Compile OpenAPI schema and generate APL code for routing and handler stubs.
⍝ args[1]: schema, OpenAPI schema file
⍝ args[2]: serverdir, folder to put compiled classes into
⍝ args[3]: handlerdir, folder to put generated handler stubs in (optional)
 schemaFile serverdir handlerdir←3↑(⊆args),'' ''
 serverdir,←('\/'∊⍨⊃⌽serverdir)↓'/'
 toolsdir←'_OpenApiTools'
 toolsrestdir←'_OpenApiToolsRest'
 nsname←'-(.)'⎕R'\u1'⊢'-',2⊃⎕NPARTS schemaFile
 svcdir←serverdir,nsname
 3 ⎕NDELETE svcdir
 2 ⎕MKDIR svcdir
 schema←⎕JSON⊃⎕NGET schemaFile
 ##.CompileComponents schema svcdir toolsdir
 :If 9=schema.⎕NC'paths'
 :AndIf 0<≢schema.paths.⎕NL ¯9
     lines←##.CompileController schema toolsrestdir nsname
     (⊂lines)⎕NPUT(svcdir,'/',nsname,'Rest.aplc')1
 :AndIf 0<≢handlerdir
     r←##.GenerateStubs schema handlerdir
 :EndIf
 opts←⎕NS ⍬
 opts.overwrite←1
 3 ⎕NDELETE serverdir∘,¨toolsdir toolsrestdir
 {}opts ⎕SE.Link.Export ##.Tools(serverdir,toolsdir)
 {}opts ⎕SE.Link.Export ##.ToolsController(serverdir,toolsrestdir)
 1 ⎕NDELETE serverdir,toolsdir,'/.linkconfig'
 1 ⎕NDELETE serverdir,toolsrestdir,'/.linkconfig'
 msg←'OpenAPI Descriptions compiled into classes in ''',serverdir,''''
 msg,←(0<≢handlerdir)/' and handlers in ''',handlerdir,''''
⍝
