 msg←targetdir Compile openapidir;schema;paths;path;pathName;name;schemaFiles;schemaFile;baseUrl;url;pathObj;lines;reqBody;args;ns;nsname;cmdns;svcdir;compnames;compname;compsdir;compdir;compobj;pathsdir;depth;toolsdir;opts
⍝ Compile OpenAPI schemas and generate APL code
 targetdir,←('\/'∊⍨⊃⌽targetdir)↓'/'
 schemaFiles←⊃⎕NINFO⍠1⊢openapidir,'/*.json'
 toolsdir←'_OpenApiTools'
 :For schemaFile :In schemaFiles
     nsname←'-(.)'⎕R'\u1'⊢'-',2⊃⎕NPARTS schemaFile
     svcdir←targetdir,nsname
     3 ⎕NDELETE svcdir
     2 ⎕MKDIR svcdir
     schema←⎕JSON⊃⎕NGET schemaFile
     :If 0≠schema.⎕NC'components'
         compnames←schema.components.schemas.⎕NL ¯9
         compsdir←svcdir,'/components/schemas/'
         :For compname :In compnames
             compdir name←2↑⎕NPARTS 1 ##.Tools.translatePath 1(7162⌶)compname
             :If ¯1=⎕NC name
                 ∘∘∘
             :EndIf
             3 ⎕MKDIR compsdir,compdir
             compobj←schema.components.schemas.⍎compname
             :If 0≠compobj.⎕NC'allOf'
                 compobj←##.CombineAllof compobj name
             :EndIf
             :If ∧/0≠compobj.⎕NC'type' 'properties'
             :AndIf compobj.type≡'object'
                 depth←3+''≢compdir
                 lines←depth ##.CompileObject toolsdir compobj name
                 (⊂lines)⎕NPUT(compsdir,compdir,name,'.aplc')1
             :ElseIf 0≠compobj.⎕NC'enum'
                 lines←##.CompileEnum compobj name
                 (⊂lines)⎕NPUT(compsdir,compdir,name,'.aplc')1
             :EndIf
         :EndFor
     :EndIf
     :If 0≠schema.⎕NC'paths'
         pathsdir←svcdir,'/paths/'
         3 ⎕MKDIR pathsdir
         baseUrl←{6::'' ⋄ ⊃⍵.servers.url}schema
         paths←schema.paths.⎕NL ¯9
         :For pathName :In paths
             url←baseUrl,path←1(7162⌶)pathName
             pathObj←schema.paths.⍎pathName
             name←##.GenerateNameFromPath path
             depth←2
             lines←depth ##.CompileService pathObj name url schema toolsdir
             (⊂lines)⎕NPUT(svcdir,'/paths/',name,'.aplc')1
         :EndFor
     :EndIf
 :EndFor
 opts←⎕NS ⍬
 opts.overwrite←1
 {}opts ⎕SE.Link.Export ##.Tools(targetdir,toolsdir)
 1 ⎕NDELETE targetdir,toolsdir,'/.linkconfig'
 msg←'OpenAPI Descriptions compiled into classes in ''',targetdir,''''
⍝
