 r←clt execute(command cmdObj args);qp;qpmask;urlmask;mask;res;paramscnt;paramnames;hasParams;hasReqBody;in;rc;resp;csrf;payload;etag
⍝clt:  obj, HttpClient instance
RETRY:
 clt.Command←command
 clt.URL←∆url
 hasParams hasReqBody←0≠cmdObj.⎕NC'parameters' 'requestBody'
 :If hasParams<hasReqBody
     :If 9.2=⎕NC⊂'args'
     :AndIf ¯3.1=args.⎕NC⊂'toObject'
         clt.Params←args.toObject
     :Else
         clt.Params←args
     :EndIf
 :ElseIf hasParams
     paramscnt←hasReqBody+≢cmdObj.parameters
     qp←paramscnt↑args,paramscnt⍴⊂''
     paramnames←cmdObj.parameters.name,hasReqBody/⊂'requestBody'
     in←cmdObj.parameters.in,hasReqBody/⊂'body'
     qpmask←in∊⊂'query'
     urlmask←in∊⊂'path'
     :If ∨/urlmask
         clt.URL←('{',¨,∘'}'¨urlmask/paramnames)⎕R(urlmask/qp)⊢clt.URL
     :EndIf
     mask←qpmask∧~qp∊⊂''
     :If ∨/mask
         clt.Params←mask⌿paramnames,⍪qp
     :ElseIf hasReqBody
         payload←(in⍳⊂'body')⊃qp
         clt.Params←payload
         :If command≡'patch'
         :AndIf 2=⎕NC'payload.__metadata.etag'
             'If-Match'clt.SetHeader payload.__metadata.etag
         :EndIf
     :Else
         clt.Params←''
     :EndIf
 :EndIf
 res←clt.Run
 :If res.IsOK
     r←0(⎕JSON res.Data)
     :If 0<≢csrf←res.GetHeader'x-csrf-token'
         'x-csrf-token'clt.SetHeader csrf
     :EndIf
     :If 0<≢etag←res.GetHeader'ETag'
         'If-Match'clt.SetHeader etag
     :EndIf
 :ElseIf res.Data≡'CSRF token validation failed'
     'x-csrf-token'clt.SetHeader'fetch'
     rc resp←clt Get(-hasReqBody)↓args
 :AndIf rc=0
     →RETRY
 :Else
     r←res.(HttpStatus HttpMessage)
 :EndIf
 :If command≡'patch'
     clt.RemoveHeader'If-Match'
 :EndIf
