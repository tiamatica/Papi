 r←defaultValue(schema classname);comp
 :If 0≠schema.⎕NC'type'
     :If schema.type≡'string'
         r←''
     :ElseIf schema.type≡'boolean'
         r←⊂'false'
     :ElseIf schema.type≡'array'
         r←⍬
     :ElseIf schema.type≡'integer'
         r←0
     :ElseIf schema.type≡'number'
         r←0
     :ElseIf schema.type≡'object'
         :If classname≢''
             r←⎕NEW⍎classname
         :Else
             r←⍬
         :EndIf
     :Else
         ∘∘∘
     :EndIf
 :ElseIf 0≠schema.⎕NC'anyOf'
 :AndIf schema.anyOf.type≡'number' 'string'
     r←0
 :ElseIf 0≠schema.⎕NC'⍙⍙36⍙ref'
     comp←getComponent schema
     r←⎕NEW comp
 :Else
     ∘∘∘
 :EndIf
