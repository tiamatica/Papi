r←clt execute(command cmdObj args);qp;qpmask;urlmask;mask;res;paramscnt;paramnames;hasParams;hasReqBody;in;rc;resp;csrf;etag;payload;msg;explode;vals
⍝clt:  obj, HttpClient instance
 clt.Command←command
 clt.BaseURL{0=≢⍺:⍵ ⋄ ⍺}←∆baseurl
 clt.URL←∆path
 clt.Params←''
 hasParams hasReqBody←0≠cmdObj.⎕NC'parameters' 'requestBody'
 :If hasParams<hasReqBody
     clt.Params←checkPayload args
 :ElseIf hasParams
     paramscnt←hasReqBody+≢cmdObj.parameters
     qp←paramscnt↑args,paramscnt⍴⊂''
     paramnames←cmdObj.parameters.name,hasReqBody/⊂'requestBody'
     in←cmdObj.parameters.in,hasReqBody/⊂'body'
     explode←({0::1 ⋄ ⍵.explode≢⊂'false'}¨cmdObj.parameters),hasReqBody/1
     qpmask←in∊⊂'query'
     urlmask←in∊⊂'path'
     :If ∨/urlmask
         clt.URL←('{',¨,∘'}'¨urlmask/paramnames)⎕R(⍕¨urlmask/qp)⊢clt.URL
     :EndIf
     mask←qpmask∧~qp∊⊂''
     :If ∨/mask
         vals←explode{(⍺=0)∧2=≡⍵:1↓∊',',¨⍵ ⋄ (⍺=1)∧1=≡⍵:','(≠⊆⊢)⍵ ⋄ ⍵}¨qp
         clt.URL,←'?',clt.UrlEncode⊃⍪/mask/paramnames{(⊂⍺),⍪⊆⍵}¨vals
     :EndIf
     :If hasReqBody
         payload←(in⍳⊂'body')⊃qp
         clt.Params←checkPayload payload
         :If command≡'patch'
         :AndIf 2=⎕NC'payload.__metadata.etag'
             'If-Match'clt.SetHeader payload.__metadata.etag
         :EndIf
     :EndIf
 :EndIf
 :If ((⊂command)∊'post' 'patch' 'put')∧0=≢clt.Params
     'Content-Length'clt.AddHeader'0'
 :EndIf
 res←clt.Run
 clt.RemoveHeader'Content-Length'
 :If res.IsOK
     r←0 res.HttpStatus(⎕JSON res.Data)
     :If 0<≢csrf←res.GetHeader'x-csrf-token'
         'x-csrf-token'clt.SetHeader csrf
     :EndIf
     :If 0<≢etag←res.GetHeader'ETag'
         'If-Match'clt.SetHeader etag
     :EndIf
 :ElseIf res.rc=0
     r←res.(HttpStatus HttpMessage Data)
 :Else
     r←res.(rc msg Data)
 :EndIf
 :If command≡'patch'
     clt.RemoveHeader'If-Match'
 :EndIf
