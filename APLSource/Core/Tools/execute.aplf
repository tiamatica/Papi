 r←clt execute(command cmdObj args);qp;qpmask;urlmask;mask;paramscnt;paramnames;hasParams;hasReqBody;in;csrf;etag;payload;hasSharedParams;paramobjs;msg
⍝clt:  obj, HttpClient instance
 clt.Command←command
 clt.URL←∆url
 clt.Params←''
 hasSharedParams←⊃0≠cmdObj.##.⎕NC'parameters'
 hasParams hasReqBody←0≠cmdObj.⎕NC'parameters' 'requestBody'
 :If (hasParams∨hasSharedParams)<hasReqBody
     clt.Params←checkPayload args
 :ElseIf hasParams∨hasSharedParams
     paramobjs←∊(hasParams hasSharedParams/cmdObj cmdObj.##).parameters
     paramscnt←hasReqBody+≢paramobjs
     qp←paramscnt↑args,paramscnt⍴⊂''
     paramnames←paramobjs.name,hasReqBody/⊂'requestBody'
     in←paramobjs.in,hasReqBody/⊂'body'
     qpmask←in∊⊂'query'
     urlmask←in∊⊂'path'
     :If ∨/urlmask
         clt.URL←('{',¨,∘'}'¨urlmask/paramnames)⎕R(⍕¨urlmask/qp)⊢clt.URL
     :EndIf
     mask←qpmask∧~qp∊⊂''
     :If ∨/mask
         clt.URL,←'?',clt.UrlEncode mask⌿paramnames,⍪qp
     :EndIf
     :If hasReqBody
         payload←(in⍳⊂'body')⊃qp
         clt.Params←checkPayload payload
         :If command≡'patch'
         :AndIf 2=⎕NC'payload.__metadata.etag'
             'If-Match'clt.SetHeader payload.__metadata.etag
         :EndIf
     :EndIf
 :EndIf
 :If ((⊂command)∊'post' 'patch' 'put')∧0=≢clt.Params
     'Content-Length'clt.AddHeader'0'
 :EndIf
 r←clt.Run
 clt.RemoveHeader'Content-Length'
 :If r.IsOK
     :If 0<≢csrf←r.GetHeader'x-csrf-token'
         'x-csrf-token'clt.SetHeader csrf
     :EndIf
     :If 0<≢etag←r.GetHeader'ETag'
         'If-Match'clt.SetHeader etag
     :EndIf
 :EndIf
 :If command≡'patch'
     clt.RemoveHeader'If-Match'
 :EndIf
