 r←GenerateNameFromPath paths;names;path;string;pattern;i;duplIdx;suffix
 names←''
 :For path :In paths
     string←'''(?:[^\r\n'']|'''')*'''
     pattern←'(\((?:',string,'|[^()'']|(?1))*\))'  ⍝ group: (nested)parens
     names,←⊂'^_?.'⎕R'\u0'⊢'^/'pattern'((/{\w+})+)' '[^A-Za-zÀ-ÖØ-Ýß-öø-üþ∆⍙Ⓐ-Ⓩ0-9]'⎕R'' 'Key' 'Key' '_'⊢path
 :EndFor
 duplIdx←i/⍨1<≢¨i←(⊂⊢)⌸names
 :If 0<≢duplIdx
     suffix←⊃,/{'_',∘⍕¨⍳≢⍵}¨duplIdx
     names[∊duplIdx],←suffix
 :EndIf
 r←names
 ⍝
