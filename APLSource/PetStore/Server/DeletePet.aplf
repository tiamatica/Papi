 r←DeletePet(req parms);err;hits;mask
⍝@path /pets/{id}
⍝@method delete
 mask←PETS[;1]=parms.id
 :If 1=hits←+/mask
     PETS⌿⍨←~mask
     r←''
 :Else
     req.Fail 404
     err←⎕NEW #.PetStoreApi.PetstoreExpanded.components.schemas.Error
     err.code←(1+hits>1)⊃1 2
     err.message←(1+hits>1)⊃'Record not found' 'More than one record found with same id'
     r←⎕UCS'UTF-8'⎕UCS ⎕JSON err.toObject
     req.Response.Headers⍪←'Content-Type' 'application/json;charset=UTF-8'
 :EndIf
⍝
