 msg←Compile args;schemasdir;clientdir;schemaFiles;toolsdir;schemaFile;nsname;svcdir;schema;opts
⍝ Compile OpenAPI schemas and generate APL code
⍝ args[1]: schemasdir, folder with OpenAPI schema files
⍝ args[2]: clientdir,  folder to put compiled classes into
 schemasdir clientdir←args
 clientdir,←('\/'∊⍨⊃⌽clientdir)↓'/'
 schemaFiles←⊃⎕NINFO⍠1⊢schemasdir,'/*.json'
 toolsdir←'_OpenApiTools'
 :For schemaFile :In schemaFiles
     nsname←'-(.)'⎕R'\u1'⊢'-',2⊃⎕NPARTS schemaFile
     svcdir←clientdir,nsname
     3 ⎕NDELETE svcdir
     2 ⎕MKDIR svcdir
     schema←⎕JSON⊃⎕NGET schemaFile
     ##.CompileComponents schema svcdir toolsdir
     ##.CompilePaths schema svcdir toolsdir
 :EndFor
 opts←⎕NS ⍬
 opts.overwrite←1
 3 ⎕NDELETE clientdir,toolsdir
 {}opts ⎕SE.Link.Export ##.Tools(clientdir,toolsdir)
 1 ⎕NDELETE clientdir,toolsdir,'/.linkconfig'
 msg←'OpenAPI Descriptions compiled into classes in ''',clientdir,''''
⍝
