 RunTestsInContainer;cfg;cfgMutsu

 cfg←⎕SE.Cider.CreateOpenParms ⍬
 cfg.batch←1
 cfg.folder←'.'
 ⎕SE.Cider.OpenProject cfg

 :Trap 0
     cfgMutsu←#.Papi.Mutsu.NewConfiguration
     cfgMutsu.TestSpaces←#.Papi.Tests.UnitTests
     cfgMutsu.ReportType←#.Papi.Mutsu.REPORTTYPE.GITHUB
     #.Papi.Mutsu.RunTests cfgMutsu
 :Else
     ⎕←↑⎕DM
     ⎕OFF 1
 :EndTrap
 ⎕OFF 0
