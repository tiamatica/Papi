 r←clt execute(command cmdObj args);qp;qpmask;urlmask;mask;res;paramscnt;paramnames;hasParams;hasReqBody;in;rc;resp;csrf;etag;payload;hasSharedParams;paramobjs
⍝clt:  obj, HttpClient instance
RETRY:
 clt.Command←command
 clt.URL←∆url
 hasSharedParams←0≠cmdObj.##.⎕NC'parameters'
 hasParams hasReqBody←0≠cmdObj.⎕NC'parameters' 'requestBody'
 :If hasParams<hasReqBody
     clt.Params←checkPayload args
 :ElseIf hasParams∨hasSharedParams
     paramobjs←(hasParams/cmdObj),hasSharedParams/cmdObj.##
     paramscnt←+⌿hasReqBody,paramobjs.(≢parameters)
     qp←paramscnt↑args,paramscnt⍴⊂''
     paramnames←(⊃,/paramobjs.parameters.name),hasReqBody/⊂'requestBody'
     in←(⊃,/paramobjs.parameters.in),hasReqBody/⊂'body'
     qpmask←in∊⊂'query'
     urlmask←in∊⊂'path'
     :If ∨/urlmask
         clt.URL←('{',¨,∘'}'¨urlmask/paramnames)⎕R(urlmask/qp)⊢clt.URL
     :EndIf
     mask←qpmask∧~qp∊⊂''
     :If ∨/mask
         clt.Params←mask⌿paramnames,⍪qp
     :ElseIf hasReqBody
         payload←(in⍳⊂'body')⊃qp
         clt.Params←checkPayload payload
         :If command≡'patch'
         :AndIf 2=⎕NC'payload.__metadata.etag'
             'If-Match'clt.SetHeader payload.__metadata.etag
         :EndIf
     :Else
         clt.Params←''
     :EndIf
 :EndIf
 res←clt.Run
 :If res.IsOK
     r←0(⎕JSON res.Data)
     :If 0<≢csrf←res.GetHeader'x-csrf-token'
         'x-csrf-token'clt.SetHeader csrf
     :EndIf
     :If 0<≢etag←res.GetHeader'ETag'
         'If-Match'clt.SetHeader etag
     :EndIf
 :ElseIf 'Required'≡res.GetHeader'x-csrf-token' ⍝res.Data≡'CSRF token validation failed'
     'x-csrf-token'clt.SetHeader'fetch'
     rc resp←clt Get(-hasReqBody)↓args
 :AndIf rc=0
     →RETRY
 :Else
     r←res.(HttpStatus HttpMessage)
 :EndIf
 :If command≡'patch'
     clt.RemoveHeader'If-Match'
 :EndIf
