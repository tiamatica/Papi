{
    "openapi": "3.1.1",
    "info": {
      "version": "0.0.0",
      "title": "Test ODA",
      "description": "An API description used for testing"
    },
    "servers": [
      {
        "url": "https://testbaseurl.com"
      }
    ],
    "paths": {
      "/thing": {
        "get": {
          "description": "Return all things. \r\n\r\n    No parameters.\n",
          "responses": {
            "200": {
              "description": "thing response",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Thing"
                    }
                  }
                }
              }
            },
            "default": {
              "description": "unexpected error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        },
        "post": {
          "description": "Creates a new thing. Duplicates are allowed",
          "operationId": "addThing",
          "parameters": [
            {
              "in": "query",
              "name": "homeId",
              "schema": {
                "example": "{{homeId}}",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "name",
              "schema": {
                "example": "{{name}}",
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "description": "Thing to add.\r\n\r\nNew line.",
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewThing"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "thing response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Thing"
                  }
                }
              }
            },
            "default": {
              "description": "unexpected error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      },
      "/thing/(id={id})": {
        "get": {
          "description": "Returns a thing based on a single ID",
          "operationId": "find thing by id",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "description": "ID of thing to fetch",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "thing response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Thing"
                  }
                }
              }
            },
            "default": {
              "description": "unexpected error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        },
        "delete": {
          "description": "deletes a single thing based on the ID supplied",
          "operationId": "deleteThing",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "description": "ID of thing to delete",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "thing deleted"
            },
            "default": {
              "description": "unexpected error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      },
      "/thing/(id={id}, age={age})": {
        "get": {
          "description": "Returns a thing based on a single ID",
          "operationId": "find thing by id",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "description": "ID of thing to fetch",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "age",
              "in": "path",
              "description": "age of thing to fetch",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "thing response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Thing"
                  }
                }
              }
            }
          }
        }
      },
      "/anotherthing/{id}": {
        "parameters": [
            {
              "name": "id",
              "in": "path",
              "description": "ID of thing to fetch. Parameter in path object that is shared by all operations.",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            }
          ],
        "get": {
          "description": "Returns another thing based on a single ID",
          "operationId": "find anotherthing by id",
          "parameters": [
            {
              "name": "limit",
              "in": "query",
              "description": "maximum number of results to return",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32"
              }
            },
            {
                "name": "tags",
                "in": "query",
                "description": "tags to filter by",
                "required": false,
                "style": "form",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
          ],
          "responses": {
            "200": {
              "description": "thing response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/AnotherThing"
                  }
                }
              }
            },
            "default": {
              "description": "unexpected error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        },
        "delete": {
          "description": "deletes a single anotherthing based on the ID supplied",
          "operationId": "delete AnotherThing",
          "responses": {
            "204": {
              "description": "thing deleted"
            },
            "default": {
              "description": "unexpected error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          }
        }
      },
      "/nestrqbody": {
        "post": {
          "description": "This call creates a new nesrrqbody.  \n\nRequest body should contain an 'object' object which should atleast have a property `name`.\n\r",
          "operationId": "createNestrqbody",
          "parameters": [
            {
              "in": "query",
              "name": "space",
              "schema": {
                "example": "{{spaceId}}",
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "example": {
                  "object": {
                    "description": "This is description.",
                    "name": "Name",
                    "summary": "This is supposed to be a short summary."
                  }
                },
                "schema": {
                  "properties": {
                    "object": {
                      "properties": {
                        "description": {
                          "example": "This is description.",
                          "type": "string"
                        },
                        "name": {
                          "example": "Name",
                          "type": "string"
                        },
                        "summary": {
                          "example": "This is supposed to be a short summary.",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "Thing": {
          "allOf": [
            {
              "$ref": "#/components/schemas/NewThing"
            },
            {
                "$ref": "#/components/schemas/AnotherThing"
            },
            {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          ]
        },
        "NewThing": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "colour": {
            "$ref": "#/components/schemas/Colour"
          },
          "countrycode": {
            "$ref": "#/components/schemas/CountryCodeEnum"
          }
          }
        },
        "AnotherThing": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "Colour": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "hex": {
              "type": "string"
            }
          }
        },
        "CountryCodeEnum": {
        "enum": [
          "46", "47"        
        ]
      },
        "Error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "integer",
              "format": "int32"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
