 r←schema CompileService(obj name url);commands;cmdObj;command;reqBody;args;f;hasRequestBody
 r←⍬
 r,←⊂':Class ',name
 r,←⊂':Include #.OpenAPI.Tools'
 r,←⊂'    :Field Private Shared ∆schema←⎕JSON ',Quote ⎕JSON obj
 r,←⊂'    :Field Private Shared ∆url←',Quote url

 commands←obj.⎕NL ¯9
 :For command :In commands
     cmdObj←obj.⍎command
     hasRequestBody←0≠cmdObj.⎕NC'requestBody'
     r,←⊂''
     f←⍬
     f,←⊂'r←clt ',({(1 ⎕C↑⍵),1↓⍵}command),' args'
     f,←⊂':Access Public Shared'
     f,←⊂'⍝ ',(cmdObj.description~⎕UCS 10),' (don''t modify, generated by ',(↑⎕XSI),')'
     f,←⊂'⍝clt:  obj, HttpClient instance'
     :If 0=cmdObj.⎕NC'parameters'
         :If hasRequestBody
             f,←⊂'⍝args: obj, ',{6::'' ⋄ ⍵.description}cmdObj.requestBody
         :Else
             f,←⊂'⍝args: bs, dummy'
         :EndIf
     :Else
         reqBody←⍬
         :If hasRequestBody
             reqBody←⎕NS''
             reqBody.name←'requestBody'
             reqBody.description←{6::'' ⋄ ⍵.description}cmdObj.requestBody
             reqBody.schema←schema ResolveRef cmdObj.requestBody.content
         :EndIf
         args←cmdObj.parameters,reqBody
         f,←⊂'⍝args: mv,  parameters, vector of shape ',⍕(≢args)
         f,←1↓¨↓⍕⊃(⍕¨⍳≢args){
             paramschema←schema ResolveRef ⍵
             aplType←('integer' 'string' 'boolean' 'array' 'object'⍳⊂paramschema.type)⊃'ns' 'cv' 'bs' 'mv' 'obj' 'obj'
             desc←{6::'' ⋄ ',',⍵.description~⎕UCS 10 13}⍵
             ('⍝  ',⍺,'⊃args:')(aplType,',')⍵.name paramschema.type desc
         }¨args
     :EndIf
     f,←⊂'r←clt execute ',(Quote command),' ∆schema.',command,' args'
     f,←⊂''
     r,←(⊂'    '),¨(1⌽'∇ ' '∇ ',(¯2+≢f)⍴⊂'  '),¨f
     :If hasRequestBody
         r,←⊂''
         f←⍬
         f,←⊂'r←',({(1 ⎕C↑⍵),1↓⍵}command),'RequestBody;comp'
         f,←⊂':Access Public Shared'
         f,←⊂'⍝ ',(cmdObj.description~⎕UCS 10),' (don''t modify, generated by ',(↑⎕XSI),')'
         f,←⊂'comp←getComponent ∆schema.',command,'.requestBody.content'
         f,←⊂'r←(↑⎕RSI).⎕NEW comp'
         f,←⊂''
         r,←(⊂'    '),¨(1⌽'∇ ' '∇ ',(¯2+≢f)⍴⊂'  '),¨f
     :EndIf
 :EndFor
 r,←⊂':EndClass ⍝ ',name
