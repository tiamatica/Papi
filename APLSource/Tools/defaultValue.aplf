 r←defaultValue schema
 :If 0≠schema.⎕NC'type'
     :If schema.type≡'string'
         r←''
     :ElseIf schema.type≡'boolean'
         r←⊂'false'
     :ElseIf schema.type≡'array'
         r←⍬
     :ElseIf schema.type≡'integer'
        r←0
     :Else
         ∘∘∘
     :EndIf
 :ElseIf 0≠schema.⎕NC'anyOf'
 :AndIf schema.anyOf.type≡'number' 'string'
     r←0
 :Else
     ∘∘∘
 :EndIf
