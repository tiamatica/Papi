 r←methodHandler(req path pathObj ind);handlerFn;handlerInd;method;parms;rc
 r←''
 :If ~(⊂req.Method)∊pathObj.⎕NL ¯9
     'Method not allowed'req.Fail 405
     →0
 :EndIf
 method←pathObj.⍎req.Method
 rc parms←parameterHandler req path method ind
 →(rc≠0)/0
 handlerInd←∆operations⍳path req.Method
 :If handlerInd>≢∆operations
     ('Operation not yet implemented: [',req.Method,' ',path,']')req.Fail 501
 :Else
     handlerFn←(∆operations⍳path req.Method)⊃∆operationHandlers
     r←(∆handlerSpace.⍎handlerFn)req parms
 :EndIf
